# Copiez ce fichier en .env et remplissez vos valeurs Supabase
# Ne jamais committer le fichier .env dans git

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre_clé_anon_publique

# Google Analytics 4 (optionnel) — identifiant de mesure, ex. G-XXXXXXXXXX
VITE_GA_MEASUREMENT_ID=
# Lien direct vers votre propriété GA4 (optionnel)
# VITE_GA_DASHBOARD_URL=https://analytics.google.com/analytics/web/#/p123456789/reports/intelligenthome

# Google Search Console (optionnel — valeur par défaut : propriété sc-domain:animargueil.fr)
# VITE_SEARCH_CONSOLE_URL=https://search.google.com/search-console?resource_id=sc-domain%3Aanimargueil.fr
